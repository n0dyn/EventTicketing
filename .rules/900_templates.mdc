## Backend Templates (FastAPI)

### API Endpoint Template
```python
from fastapi import APIRouter, Depends, HTTPException
from sqlalchemy.orm import Session
from typing import List

from app.db.session import get_db
from app.models import ModelName
from app.schemas import ModelCreate, ModelResponse, ModelUpdate
from app.services import ModelService

router = APIRouter()

@router.post("/", response_model=ModelResponse)
async def create_item(
    item: ModelCreate,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user)
) -> ModelResponse:
    """Create a new item."""
    service = ModelService(db)
    return service.create_item(item, current_user.id)

@router.get("/{item_id}", response_model=ModelResponse)
async def get_item(
    item_id: int,
    db: Session = Depends(get_db)
) -> ModelResponse:
    """Get item by ID."""
    service = ModelService(db)
    item = service.get_item(item_id)
    if not item:
        raise HTTPException(status_code=404, detail="Item not found")
    return item

@router.get("/", response_model=List[ModelResponse])
async def get_items(
    skip: int = 0,
    limit: int = 100,
    db: Session = Depends(get_db)
) -> List[ModelResponse]:
    """Get all items with pagination."""
    service = ModelService(db)
    return service.get_items(skip=skip, limit=limit)

@router.put("/{item_id}", response_model=ModelResponse)
async def update_item(
    item_id: int,
    item: ModelUpdate,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user)
) -> ModelResponse:
    """Update an existing item."""
    service = ModelService(db)
    updated_item = service.update_item(item_id, item, current_user.id)
    if not updated_item:
        raise HTTPException(status_code=404, detail="Item not found")
    return updated_item

@router.delete("/{item_id}")
async def delete_item(
    item_id: int,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user)
) -> dict:
    """Delete an item."""
    service = ModelService(db)
    success = service.delete_item(item_id, current_user.id)
    if not success:
        raise HTTPException(status_code=404, detail="Item not found")
    return {"message": "Item deleted successfully"}
```

### Service Layer Template
```python
from typing import List, Optional
from sqlalchemy.orm import Session
from app.models import ModelName
from app.schemas import ModelCreate, ModelUpdate

class ModelService:
    def __init__(self, db: Session):
        self.db = db
    
    def create_item(self, item_data: ModelCreate, user_id: int) -> ModelName:
        """Create a new item."""
        db_item = ModelName(**item_data.dict(), owner_id=user_id)
        self.db.add(db_item)
        self.db.commit()
        self.db.refresh(db_item)
        return db_item
    
    def get_item(self, item_id: int) -> Optional[ModelName]:
        """Get item by ID."""
        return self.db.query(ModelName).filter(ModelName.id == item_id).first()
    
    def get_items(self, skip: int = 0, limit: int = 100) -> List[ModelName]:
        """Get items with pagination."""
        return self.db.query(ModelName).offset(skip).limit(limit).all()
    
    def update_item(self, item_id: int, item_data: ModelUpdate, user_id: int) -> Optional[ModelName]:
        """Update an existing item."""
        db_item = self.get_item(item_id)
        if not db_item:
            return None
        
        for field, value in item_data.dict(exclude_unset=True).items():
            setattr(db_item, field, value)
        
        self.db.commit()
        self.db.refresh(db_item)
        return db_item
    
    def delete_item(self, item_id: int, user_id: int) -> bool:
        """Delete an item."""
        db_item = self.get_item(item_id)
        if not db_item:
            return False
        
        self.db.delete(db_item)
        self.db.commit()
        return True
```

### Database Model Template
```python
from sqlalchemy import Column, Integer, String, DateTime, Text, ForeignKey, Boolean
from sqlalchemy.orm import relationship
from sqlalchemy.sql import func
from app.db.base_class import Base

class ModelName(Base):
    __tablename__ = "table_name"
    
    id = Column(Integer, primary_key=True, index=True)
    name = Column(String(100), nullable=False, index=True)
    description = Column(Text)
    is_active = Column(Boolean, default=True)
    created_at = Column(DateTime(timezone=True), server_default=func.now())
    updated_at = Column(DateTime(timezone=True), onupdate=func.now())
    
    # Foreign keys
    user_id = Column(Integer, ForeignKey("users.id"))
    
    # Relationships
    user = relationship("User", back_populates="items")
```

